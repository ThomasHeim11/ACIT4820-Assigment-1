<?xml version="1.0"?>
<!--Task 3- and 4-->

<launch>
<!--Paths resolved from the installed package-->
<let name="urdf_path"
    value="$(find-pkg-share my_robot_description)/urdf/my_robot.urdf"/>
<let name="rviz_config"
    value="$(find-pkg-share my_robot_description)/rviz/urdf_config.rviz"/>

<!--Publishes the URDF on /robot_description and broadcasts TF-->
<node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description"
        value="$(command 'cat $(var urdf_path)')" type="str"/>
</node>
<!--GUI sliders for left_wheel_joint and right_wheel_joint.
    Fixed joints have no DOF, so they do not appear here-->
<!--node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui"--> task 3 code 
<!--Task4-->
<node pkg="my_robot_description" exec="wheel_publisher"/>

<!--RViz with the saved config: fixed frame base_footprint-->
<node pkg="rviz2" exec="rviz2" args="-d $(var rviz_config)"/>

</launch>